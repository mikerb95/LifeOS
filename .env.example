# Turso (libSQL) database connection
# Create a database with the Turso CLI: turso db create lifeos
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Single-user password gate.
# Generate a hash with: npx tsx scripts/hash-password.ts "your password"
# IMPORTANT: escape every "$" as "\$" in this file, otherwise dotenv will
# try to expand "$2b", "$12", etc. as variable references and corrupt the hash.
AUTH_PASSWORD_HASH="\$2b\$12\$..."

# Random 32+ byte secret used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
