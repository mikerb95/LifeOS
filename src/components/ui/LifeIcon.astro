---
import { buildIcons } from '../../lib/icons';

interface Props {
  name: string;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 18, stroke = 1.7, class: className } = Astro.props;

const ICONS = buildIcons(stroke);
const svg = ICONS[name] ?? ICONS.hoy;
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={className} set:html={svg} />
